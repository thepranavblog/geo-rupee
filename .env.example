# -------------------------------------------------------
# AWS credentials — required for Spark (S3 read/write),
# Airflow (S3 sensor), and spark-submit in docker-compose
# -------------------------------------------------------
# Get these from: AWS Console > IAM > Users > Security credentials
# Minimum required S3 permissions:
#   s3:GetObject, s3:PutObject, s3:ListBucket
#   on bucket: geopolitical-rupee-pipeline
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1
